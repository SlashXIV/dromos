<?xml version="1.0" encoding="utf-8"?>
<!--
    Écran de démarrage animé : les trois couloirs se tracent l'un après
    l'autre, puis la ligne d'arrivée claque sous le D (rebond léger).
    ~800 ms, mêmes courbes que le reste de l'application.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/splash_icon">
    <target android:name="lane1">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@interpolator/dromos_transition"
                android:propertyName="trimPathEnd"
                android:startOffset="0"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="lane2">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@interpolator/dromos_transition"
                android:propertyName="trimPathEnd"
                android:startOffset="90"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="lane3">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="420"
                android:interpolator="@interpolator/dromos_transition"
                android:propertyName="trimPathEnd"
                android:startOffset="180"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
    <target android:name="finish">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="320"
                android:interpolator="@interpolator/dromos_release"
                android:propertyName="scaleX"
                android:startOffset="480"
                android:valueFrom="0"
                android:valueTo="1"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
