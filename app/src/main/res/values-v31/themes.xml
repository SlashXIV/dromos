<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : l'écran de démarrage joue l'animation des couloirs. -->
    <style name="Theme.Dromos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/avd_splash</item>
        <item name="windowSplashScreenAnimationDuration">800</item>
        <item name="postSplashScreenTheme">@style/Theme.Dromos</item>
    </style>
</resources>
