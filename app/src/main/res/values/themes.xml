<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Thème de démarrage, déclaré au manifeste : Android peint la fenêtre avec
        l'avant-plan de l'icône sur son fond avant la première ligne de code.
        MainActivity bascule ensuite sur Theme.Dromos via installSplashScreen().
    -->
    <style name="Theme.Dromos.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/icon_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Dromos</item>
    </style>

    <style name="Theme.Dromos" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
