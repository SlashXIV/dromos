<!-- Équivalent Android 11 et moins de data_extraction_rules.xml : rien ne part en sauvegarde. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
</full-backup-content>
